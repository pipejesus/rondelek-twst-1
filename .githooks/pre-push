#!/usr/bin/env bash
#
# pre-push — runs before refs are pushed to the remote.
# Activate (once, per clone) with:
#   git config core.hooksPath .githooks
#
# Mirrors CI (.github/workflows/ci.yml) so red code never leaves the machine.
set -euo pipefail

cargo clippy --locked --all-targets -- -D warnings
cargo test --locked
